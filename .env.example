# Copy to .env and fill in. Never commit .env.
# LLM providers, tried in LLM_ORDER. Leave a key empty to skip that provider;
# with no keys the service still answers with an extractive (quote-the-source) fallback.
LLM_ORDER=groq,gemini
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Prices in USD per 1M tokens (used for the cost shown on Phoenix LLM spans).
GROQ_PRICE_IN=0.075
GROQ_PRICE_OUT=0.30
GEMINI_PRICE_IN=0.30
GEMINI_PRICE_OUT=2.50

# Optional: use a Weaviate Cloud sandbox instead of the local Docker container.
WEAVIATE_URL=
WEAVIATE_API_KEY=

# Retrieval tuning
HYBRID_ALPHA=0.5
TOP_K=4
